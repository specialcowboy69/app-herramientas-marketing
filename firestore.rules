rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar: Verifica si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Función auxiliar: Verifica si el usuario es el dueño del documento existente
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Reglas para la colección 'users' (perfiles y límites de uso)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Reglas para la colección 'projects'
    match /projects/{projectId} {
      // Para leer/actualizar/borrar, el usuario debe ser el dueño del documento
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Para crear, el userId que se intenta guardar debe coincidir con el uid del usuario
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Reglas para subcolecciones dentro de proyectos (ej. documentos guardados)
      match /{document=**} {
        allow read, write: if isAuthenticated() && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
      }
    }

    // Reglas para la colección 'generations' (el historial generado por la IA)
    match /generations/{generationId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
